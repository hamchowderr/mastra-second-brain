# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Min 32 chars. Generate with: openssl rand -hex 32
APP_SECRET=

# ──────────────────────────────────────────────
# Model + LLM provider keys
# MODEL is a Mastra model-router string, "<provider>/<model-id>".
#   MODEL=anthropic/claude-sonnet-4-6   (needs ANTHROPIC_API_KEY)
#   MODEL=openai/gpt-5.5                (needs OPENAI_API_KEY)
#   MODEL=google/gemini-3.5-flash       (needs GOOGLE_GENERATIVE_AI_API_KEY)
# At least one key is required (none when USE_AIMOCK=true).
# ──────────────────────────────────────────────
MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ──────────────────────────────────────────────
# Turso / libSQL: memory, Knowledge pages and their embeddings, traces.
# Leave BLANK for local dev: a file DB (file:./mastra.db), zero setup.
# Deployed: a Turso Cloud URL + token (one database per client works well).
# ──────────────────────────────────────────────
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# Embeddings for Knowledge search and memory recall. Blank = local fastembed
# (bge-small, 384-dim, no key). Set a hosted model for serverless/edge, e.g.
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_MODEL=

# ──────────────────────────────────────────────
# Knowledge (experimental, @mastra/core 1.82+)
# ──────────────────────────────────────────────
# Org scope every agent run holds: org:<KNOWLEDGE_ORG_ID>. Use one id per client
# when you deploy this template per client. Letters, digits, - and _ only.
KNOWLEDGE_ORG_ID=default
# Folder `npm run knowledge:sync` mirrors into the org scope.
KNOWLEDGE_DIR=knowledge

# ──────────────────────────────────────────────
# Auth: JWT (@mastra/auth), shared HMAC secret. Leave blank for open local dev.
# When set, every /api/* route and Studio need a Bearer JWT signed with it, and
# Studio's Knowledge explorer shows each user only the pages they can read:
#   {"sub":"user-1"}                      → org scope + resource:user-1
#   {"sub":"ops","knowledge":["org:acme"]} → exactly those scopes
#   {"sub":"admin","knowledge":"all"}     → everything
# Mint a token:
#   node -e "import('jsonwebtoken').then(j=>console.log(j.default.sign({sub:'user-1'},process.env.MASTRA_JWT_SECRET)))"
# In Studio: Settings → Headers → Authorization = Bearer <jwt>
# ──────────────────────────────────────────────
# MASTRA_JWT_SECRET=

# ──────────────────────────────────────────────
# AIMock: deterministic, free LLM mocking for the eval
# Run: npx -y -p @copilotkit/aimock aimock -c aimock.json
# ──────────────────────────────────────────────
USE_AIMOCK=false
AIMOCK_URL=http://localhost:4010
# Set when USE_AIMOCK=true: @ai-sdk/openai reads it at module load time.
# OPENAI_BASE_URL=http://localhost:4010/v1

# ──────────────────────────────────────────────
# Mastra
# ──────────────────────────────────────────────
MASTRA_TELEMETRY_DISABLED=1
# Hosted Mastra Observe: set BOTH to also ship traces to the platform.
# MASTRA_PLATFORM_ACCESS_TOKEN=
# MASTRA_PROJECT_ID=
